---
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const { title = profile.name, description = profile.title } = Astro.props;

const nav = [
  { href: "#profile", label: "Profile" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#personal", label: "Personal" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#004d98" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="site-header">
      <a href="#profile" class="brand">{profile.name}</a>
      <nav aria-label="Sections">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main id="top">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {profile.name} ·{" "}
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </footer>

    <dialog id="lightbox">
      <button type="button" class="close" id="lb-close" aria-label="Close">×</button>
      <img id="lb-img" alt="" />
      <p id="lb-caption"></p>
      <p><a id="lb-link" target="_blank" rel="noopener" hidden></a></p>
    </dialog>

    <script>
      // Views: only the one matching the URL hash is visible.
      const views = [...document.querySelectorAll<HTMLElement>(".view")];
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".site-header nav a")];
      const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
      let shown = -1;
      function showView() {
        const id = location.hash.slice(1);
        const target = views.find((v) => v.id === id) ?? views[0];
        const idx = views.indexOf(target);
        if (idx === shown) return;
        const first = shown < 0;
        const dir = idx > shown ? 1 : -1;
        shown = idx;
        const apply = () => {
          views.forEach((v) => v.classList.toggle("active", v === target));
          links.forEach((l) => l.classList.toggle("active", l.getAttribute("href") === "#" + target.id));
          window.scrollTo({ top: 0, behavior: "instant" });
        };
        if (first || reduced) return apply();
        if (document.startViewTransition) {
          document.documentElement.style.setProperty("--vt-dir", String(dir));
          document.startViewTransition(apply);
        } else {
          apply();
          target.animate?.(
            [
              { opacity: 0, transform: `translateX(${dir * 32}px)` },
              { opacity: 1, transform: "none" },
            ],
            { duration: 380, easing: "cubic-bezier(.22, 1, .36, 1)" },
          );
        }
      }
      window.addEventListener("hashchange", showView);
      showView();

      // Lightbox shared by every element with data-lightbox.
      const dlg = document.getElementById("lightbox") as HTMLDialogElement;
      const img = document.getElementById("lb-img") as HTMLImageElement;
      const cap = document.getElementById("lb-caption")!;
      const link = document.getElementById("lb-link") as HTMLAnchorElement;
      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-lightbox]");
        if (!el) return;
        img.src = el.dataset.src!;
        img.alt = el.dataset.alt || "";
        cap.textContent = el.dataset.caption || "";
        const url = el.dataset.link;
        link.hidden = !url;
        if (url) {
          link.href = url;
          link.textContent = el.dataset.linkLabel || url;
        }
        dlg.showModal();
      });
      function closeLightbox() {
        if (reduced) return dlg.close();
        dlg.classList.add("closing");
        setTimeout(() => {
          dlg.classList.remove("closing");
          dlg.close();
        }, 180);
      }
      document.getElementById("lb-close")!.addEventListener("click", closeLightbox);
      dlg.addEventListener("cancel", (e) => {
        e.preventDefault();
        closeLightbox();
      });
      dlg.addEventListener("click", (e) => {
        if (e.target === dlg) closeLightbox();
      });
    </script>
  </body>
</html>
