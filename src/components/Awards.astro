---
import { awardsIntro, icpcAwards, olympiadAwards, icpcProfileUrl, referenceNotebook } from "../data/profile";
---

<section id="awards" class="reveal">
  <h2>Competitive Programming</h2>
  <p class="lead">Two-time ICPC World Finalist (2019, 2021) and multiple-time Caribbean Finals medalist.</p>

  <details class="more">
    <summary>ICPC results</summary>
    <p class="blurb">{awardsIntro}</p>
    <ul class="awards">
      {icpcAwards.map((a) => (
        <li><span class="year">{a.year}</span> <strong>{a.result}</strong> · {a.event}</li>
      ))}
    </ul>
  </details>

  <details class="more">
    <summary>National & international olympiads</summary>
    <ul class="awards">
      {olympiadAwards.map((a) => (
        <li><span class="year">{a.year}</span> <strong>{a.result}</strong> · {a.event}</li>
      ))}
    </ul>
  </details>

  <details class="more">
    <summary>Team reference notebook (C++)</summary>
    <p>{referenceNotebook.summary}</p>
    {referenceNotebook.categories.map((c) => (
      <>
        <h4 class="cat">{c.name}</h4>
        <ul class="tags">
          {c.items.map((i) => <li>{i}</li>)}
        </ul>
      </>
    ))}
    <p><a href={referenceNotebook.file} download class="button primary">Download the PDF</a></p>
  </details>

  <p><a href={icpcProfileUrl} target="_blank" rel="noopener" class="button">Official ICPC profile</a></p>
</section>
