---
import { skills, languages } from "../data/profile";
---

<section id="skills" class="reveal">
  <h2>Skills</h2>
  <div class="skill-grid">
    {skills.map((g) => (
      <details class="card">
        <summary>
          <span>{g.category}</span>
          <span class="count">{g.items.length}</span>
        </summary>
        <ul class="tags">
          {g.items.map((s) => <li>{s}</li>)}
        </ul>
      </details>
    ))}
    <details class="card">
      <summary>
        <span>Spoken languages</span>
        <span class="count">{languages.length}</span>
      </summary>
      <ul class="tags">
        {languages.map((l) => <li>{l.name}: {l.level}</li>)}
      </ul>
    </details>
  </div>
</section>
