---
import { skills, languages } from "../data/profile";
---

<section>
  <h2>Skills</h2>
  <div class="skill-grid">
    {skills.map((g) => (
      <div class="card">
        <h3 class="skill-title">{g.category}</h3>
        <ul class="tags">
          {g.items.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    ))}
    <div class="card">
      <h3 class="skill-title">Spoken languages</h3>
      <ul class="tags">
        {languages.map((l) => <li>{l.name}: {l.level}</li>)}
      </ul>
    </div>
  </div>
</section>
