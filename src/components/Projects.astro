---
import { projects } from "../data/profile";
---

<section>
  <h2>Projects</h2>
  {projects.map((p) => (
    <article class="card project">
      <h3>
        {p.name}
        {p.status && <span class="badge">{p.status}</span>}
      </h3>
      <p class="tagline">{p.tagline}</p>

      <ul class="tags">
        {p.stack.map((s) => <li>{s}</li>)}
      </ul>

      <div class="project-grid">
        <div>
          <h4 class="cat">The approach</h4>
          {p.description.map((d) => <p>{d}</p>)}
        </div>
        <div>
          <h4 class="cat">Results</h4>
          <ul>
            {p.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      </div>
      <pre class="pipeline">{p.pipeline}</pre>

      <p class="project-links">
        {p.repo && <a href={p.repo} target="_blank" rel="noopener" class="button">Source on GitHub</a>}
        {p.demo && <a href={p.demo} target="_blank" rel="noopener" class="button">Live demo</a>}
      </p>
    </article>
  ))}
</section>
