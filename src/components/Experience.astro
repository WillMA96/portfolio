---
import { experience, education } from "../data/profile";
---

<section id="experience" class="reveal">
  <div class="section-head">
    <h2>Experience</h2>
    <button type="button" class="link-button" id="toggle-jobs">Expand all</button>
  </div>

  <div class="timeline">
    {experience.map((job) => (
      <details class="job">
        <summary>
          <span class="job-title">{job.role}</span>
          <span class="job-company">
            {job.company}
          </span>
          <span class="meta">{job.period} · {job.location}</span>
        </summary>
        <div class="details-body">
          {job.blurb && <p class="blurb">{job.blurb}</p>}
          <ul>
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
          {job.companyUrl && (
            <p><a href={job.companyUrl} target="_blank" rel="noopener">{job.company} website</a></p>
          )}
        </div>
      </details>
    ))}
  </div>

  <h3 class="sub">Education</h3>
  {education.map((e) => (
    <p class="edu">
      <strong>{e.degree}</strong><br />
      <span class="meta">{e.school} · {e.location} · {e.period}</span>
    </p>
  ))}
</section>

<script>
  const btn = document.getElementById("toggle-jobs");
  const jobs = () => document.querySelectorAll<HTMLDetailsElement>("#experience .job");
  btn?.addEventListener("click", () => {
    const open = [...jobs()].every((d) => d.open);
    jobs().forEach((d) => (d.open = !open));
    btn.textContent = open ? "Expand all" : "Collapse all";
  });
</script>
