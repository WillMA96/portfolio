---
import { profile } from "../data/profile";
---

<section id="about" class="hero">
  <h1>{profile.name}</h1>
  <p class="subtitle">{profile.title}</p>
  <p class="meta">{profile.location}</p>

  {profile.summary.map((p) => <p>{p}</p>)}

  <ul class="contact">
    <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    <li><a href={`tel:${profile.phone.replace(/\s+/g, "")}`}>{profile.phone}</a></li>
    {profile.links.map((l) => (
      <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>
    ))}
    <li><a href={profile.cvUrl} download class="button">Download CV</a></li>
  </ul>
</section>
