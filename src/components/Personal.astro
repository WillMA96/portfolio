---
import { personal } from "../data/profile";
---

<section id="personal">
  <h2>Beyond the code</h2>
  <p>{personal.intro}</p>
  <ul>
    {personal.facts.map((f) => <li>{f}</li>)}
  </ul>

  {personal.photos.length > 0 && (
    <div class="gallery">
      {personal.photos.map((photo) => (
        <figure>
          <img src={photo.src} alt={photo.alt} loading="lazy" />
          {(photo.caption || photo.link) && (
            <figcaption>
              {photo.caption}{" "}
              {photo.link && (
                <a href={photo.link.url} target="_blank" rel="noopener">{photo.link.label}</a>
              )}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )}
</section>
