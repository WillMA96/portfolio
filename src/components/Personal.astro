---
import { personal } from "../data/profile";
---

<section>
  <h2>Beyond the code</h2>
  <p class="lead">{personal.intro}</p>
  <ul>
    {personal.facts.map((f) => <li>{f}</li>)}
  </ul>

  <div class="interests">
    {personal.interests.map((i) => (
      <div class="card">
        <h3 class="skill-title">{i.title}</h3>
        <p>{i.text}</p>
        {i.link && <p><a href={i.link.url} target="_blank" rel="noopener" class="button">{i.link.label}</a></p>}
      </div>
    ))}
  </div>

  {personal.photos.length > 0 && (
      <div class="gallery">
        {personal.photos.map((photo) => (
          <button
            type="button"
            class="thumb"
            data-lightbox
            data-src={photo.src}
            data-alt={photo.alt}
            data-caption={photo.caption ?? ""}
            data-link={photo.link?.url ?? ""}
            data-link-label={photo.link?.label ?? ""}
            aria-label={`Open photo: ${photo.alt}`}
          >
            <img src={photo.src} alt={photo.alt} loading="lazy" />
          </button>
        ))}
      </div>
  )}
</section>
